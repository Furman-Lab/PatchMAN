Bootstrap: docker
From: python:3.5.6

###########################################################
#            Container for Rosetta with MPI               #
#                                                         #
# This definition file is used for creating an image for  #
# Rosetta, with MPI support. Files for setting up both    #
# are downloaded by download_data_and_software.sh. The    #
# MPI version needs to match with the host MPI's          #
#                                                         #
#         Created by Furman Lab at HUJI, 2022.            #
###########################################################


%setup
	# Create directories for extracting the contents of the archives
	mkdir $SINGULARITY_ROOTFS/openmpi
	mkdir $SINGULARITY_ROOTFS/rosetta

	# Extract archives
	tar -xjf openmpi.tar.bz2 -C $SINGULARITY_ROOTFS/openmpi --strip-components=1
	tar -xzf rosetta.tar.gz -C $SINGULARITY_ROOTFS/rosetta --strip-components=1

%post
	##### OpenMPI #####
	# Create directories for OpenMPI
	OMPI_DIR=/opt/ompi
	PATH=$OMPI_DIR/bin:$PATH
	LD_LIBRARY_PATH=$OMPI_DIR/lib:$LD_LIBRARY_PATH
	MANPATH=$OMPI_DIR/share/man:$MANPATH

	echo "export OMPI_DIR=\"${OMPI_DIR}\"" >> $SINGULARITY_ENVIRONMENT
	echo "export PATH=\"${PATH}\"" >> $SINGULARITY_ENVIRONMENT
	echo "export LD_LIBRARY_PATH=\"${LD_LIBRARY_PATHMANPATH}\"" >> $SINGULARITY_ENVIRONMENT
	echo "export MANPATH=\"${MANPATH}\"" >> $SINGULARITY_ENVIRONMENT

	# Compile and install
	mkdir -p /opt openmpi
	cd openmpi/
	./configure --prefix=$OMPI_DIR
	make install
	cd ..
	rm -rf openmpi/


	##### Rosetta #####
	# Compile Rosetta
	ls rosetta/
	cd rosetta/main/source

	# Change extras and number of cores used for compilation as needed
	./scons.py -j 3 extras=mpi,serialization mode=release bin
