# EDIT THIS PART FOR INSTALLATION #
PYROSETTA_USER=levinthal
PYROSETTA_PASS=paradox

ROSETTA_USER=Academic_User
ROSETTA_PASS=Xry3x4

MASTER_URL="https://grigoryanlab.org/master/master-v1.6.tar.gz"

####################################
#    EDIT THIS PART FOR RUNNING    #

PROTOCOL_ROOT=$(dirname $(realpath ${BASH_SOURCE}))     # for development you don't need to change this
SINGULARITY_ROOT=$PROTOCOL_ROOT                         # for development change this to the share compiled installation

# different nodes need to be excluded on different clusters. Edit this accoring to your needs or delete it.
if [[ $(hostname) == *"phoenix"* ]]; then
    export ADD_SBATCH='--exclude=ohm-[54-62],gsm-[01,03-04],oxygen-[01-08],wadi-[01-05] --killable --requeue --ntasks=150'
elif [[ $(hostname) == *"picasso"* ]]; then
    export ADD_SBATCH=' --ntasks=100'
fi

# With default singularity installation, no need to touch these!
module try-load singularity
export SINGULARITY="$(which singularity) exec --bind ${PROTOCOL_ROOT}$1 ${SINGULARITY_ROOT}/containers/"  # $1 is the path to the work directory
export PYTHON="${SINGULARITY}/python.sif python3 "
export ROSETTA_BIN="${SINGULARITY}/rosetta.sif /rosetta/main/source/bin/"
export MASTER="${SINGULARITY}/master.sif /master/bin/"
export VIRTUAL_ENV=''   # you can leave this blank
export DB_PATH="${PROTOCOL_ROOT}/databases/master_clean/"

# Run without singularity
# export PYTHON=python_executable
# export ROSETTA_BIN=rosetta_bin_directory
# export MASTER=directory_of_master
# export VIRTUAL_ENV=path_to_virtualenv
# export DB_PATH=master_database_with_cleaned_PDB_files