Bootstrap: docker
From: python:3.5.6

###########################################################
#            Container for python and PyRosetta           #
#                                                         #
# This definition file is used for creating an image for  #
# PyRosetta, together with all the python scripts used.   #
#                                                         #
#           Created by Furman Lab at HUJI, 2022.          #
###########################################################

%setup

%files
	/vol/ek/Home/jvarga/works/PatchMAN-forServer/bin/* python_scripts
	/vol/ek/Home/jvarga/works/PatchMAN-forServer/requirements.txt .
	/vol/ek/Home/jvarga/works/PatchMAN-forServer/pyrosetta-2020.25+release.d2d9f90-cp35-cp35m-linux_x86_64.whl  .

%post
	# Install system packages that are needed for installing python packages
	apt update
	apt install -y --no-install-recommends python3-pip gfortran python3-dev
	apt -y clean
	rm -rf rm -rf /var/lib/apt/lists/*

	# Install python packages
	pip install --upgrade pip
	pip install -r requirements.txt

	# Install PyRosetta
	pip install pyrosetta-2020.25+release.d2d9f90-cp35-cp35m-linux_x86_64.whl
	rm pyrosetta-2020.25+release.d2d9f90-cp35-cp35m-linux_x86_64.whl
