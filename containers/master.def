Bootstrap: docker
From: debian

###########################################################
#                  Container for MASTER                   #
#                                                         #
# This definition file is used for creating an image for  #
# MASTER, with its output modified for running PatchMAN.  #
#                                                         #
#           Created by Furman Lab at HUJI, 2022.          #
###########################################################

%setup
	# Create directory for extracting the contents of the the master archive
	mkdir $SINGULARITY_ROOTFS/master

	tar -xzf master.tar.gz -C $SINGULARITY_ROOTFS/master --strip-components=1
	tar -xzf mslib.tar.gz -C $SINGULARITY_ROOTFS/

%files
	../bin/master.patch .

%post
	# Install system packages that are needed for building Rosetta
	apt -y update
	apt -y install curl make build-essential dos2unix

	# Patch	MASTER to provide the translation rotation matrix as an output
	cp master/src/Match.cpp master/src/Match_old.cpp
	dos2unix master/src/Match.cpp
	patch -l master/src/Match.cpp master.patch

	# Compile MASTER
	cd master/
	make all
